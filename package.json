{
  "name": "agent-cast",
  "version": "0.8.6",
  "private": true,
  "description": "Personal AI Podcast Chrome Extension powered by your own browser sessions",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch",
    "build": "node scripts/build-extension.mjs",
    "build:prod": "BUILD_TARGET=production node scripts/build-extension.mjs",
    "package:cws": "node scripts/package-cws.mjs",
    "sync:gdrive": "node scripts/build-extension.mjs && node scripts/sync-gdrive.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.0.11",
    "mp4-muxer": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.313",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
